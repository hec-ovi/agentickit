# Pick ONE provider.
#
# vLLM (local, OpenAI-compatible at /v1). The example uses the Responses API
# with streaming on, and injects `chat_template_kwargs.enable_thinking=false`
# into every /responses POST so Qwen3 / similar models don't stream a long
# reasoning block before the answer. See server/index.ts.
OPENAI_API_KEY=dummy-vllm-ignores-this
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
PILOT_MODEL=openai/Qwen3.6-27B-AWQ4

# Force the legacy Chat Completions path (older OSS Responses servers that
# never emit `function_call_arguments.done`). Default off.
# AGENTICKIT_OPENAI_PROTOCOL=chat

# Or a hosted provider:
# OPENAI_API_KEY=sk-...
# PILOT_MODEL=openai/gpt-4o-mini

# Server port (API route). The Vite dev server proxies /api to this.
PORT=8787
