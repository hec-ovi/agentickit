{
  "name": "@agentickit-examples/travel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Polished travel-planning showcase for agentickit. Multi-page app, three theme modes, every primitive.",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"pnpm dev:client\" \"pnpm dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file=.env.local server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.53",
    "@ag-ui/core": "0.0.53",
    "@ai-sdk/openai": "^3.0.53",
    "@hec-ovi/agentickit": "workspace:*",
    "ai": "^6.0.0",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "happy-dom": "^15.11.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
