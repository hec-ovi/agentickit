# Pick ONE provider.
#
# vLLM (local, OpenAI-compatible at /v1). Streaming on, reasoning off,
# Responses API only. Server injects chat_template_kwargs.enable_thinking=false
# on every /responses POST.
OPENAI_API_KEY=dummy-vllm-ignores-this
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
PILOT_MODEL=openai/Qwen3.6-27B-AWQ4

# Force the legacy Chat Completions path (older OSS Responses servers).
# AGENTICKIT_OPENAI_PROTOCOL=chat

# Or a hosted provider:
# OPENAI_API_KEY=sk-...
# PILOT_MODEL=openai/gpt-4o-mini

# Or another adapter the package supports (anthropic, groq, google, mistral,
# openrouter, AI Gateway). See packages/agentickit/README.md.
# ANTHROPIC_API_KEY=sk-ant-...
# PILOT_MODEL=anthropic/claude-haiku-4-5

# Server port (Vite dev server proxies /api to this).
PORT=8788

# OpenWeather API key. Optional. When set, /api/weather proxies to
# api.openweathermap.org. When unset, /api/weather returns deterministic mock
# data so the example works fully offline.
# OPENWEATHER_API_KEY=...

# -------------------------------------------------------------------
# Web-search backends (used by the search_* tools).
# Each is optional and independent. Mount only the plugins whose keys are
# set, OR mount all five and the agent will see structured 503 errors
# from any backend whose key is missing. DuckDuckGo needs no key.
# -------------------------------------------------------------------

# Brave Search API. Free tier ~2000 queries/month.
# Sign up: https://brave.com/search/api/
# BRAVE_API_KEY=

# Tavily (LLM-optimized search). Free tier ~1000 queries/month.
# Sign up: https://tavily.com
# TAVILY_API_KEY=

# Firecrawl (search + scrape). Free tier available.
# Sign up: https://firecrawl.dev
# FIRECRAWL_API_KEY=

# Google Custom Search Engine. Free tier 100 queries/day.
# Setup steps:
#   1. https://console.cloud.google.com → enable "Custom Search API"
#   2. Credentials → create API key  →  GOOGLE_API_KEY
#   3. https://programmablesearchengine.google.com → create a search engine,
#      enable "Search the entire web", copy the search-engine id →  GOOGLE_CSE_ID
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
